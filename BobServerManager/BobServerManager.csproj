<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BobServerManager</AssemblyName>
    <RootNamespace>BobServerManager</RootNamespace>
    <ApplicationIcon></ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Beasts of Bermuda Server Manager</Product>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Allows plain "dotnet publish" (no -r flag needed) to still produce a
         self-contained single-file win-x64 exe, per the README instructions. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
